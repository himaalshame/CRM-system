// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
  CLIENT
}

enum OrderStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

// enum PaymentStatus {
//   PENDING
//   PAID
//   FAILED
// }

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(CLIENT)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  employee Employee?
  client   Client?

  @@map("users")
}

model Employee {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  fname     String
  lname     String
  phone     String
  jobTitle  String   @map("job_title")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  managedOrders    Order[]           @relation("EmployeeOrders")
  projectEmployees ProjectEmployee[]

  @@map("employees")
}

model Client {
  id        String   @id @default(uuid())
  userId    String?  @unique @map("user_id")
  fname     String
  lname     String
  phone     String
  address   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@map("clients")
}

model Order {
  id            String             @id @default(uuid())
  clientId      String             @map("client_id")
  employeeId    String?            @map("employee_id")
  status        OrderStatus        @default(PENDING)
  totalPrice    Decimal            @map("total_price") @db.Decimal(10, 2)
  paymentStatus OrderPaymentStatus @default(UNPAID) @map("payment_status")

  startDate DateTime? @map("start_date")
  endDate   DateTime? @map("end_date")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  client     Client      @relation(fields: [clientId], references: [id])
  employee   Employee?   @relation("EmployeeOrders", fields: [employeeId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]
  project    Project?

  @@map("orders")
}

model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@map("services")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String  @map("order_id")
  serviceId String  @map("service_id")
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)
  quantity  Int     @default(1)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("order_items")
}

model Project {
  id        String        @id @default(uuid())
  orderId   String        @unique @map("order_id")
  name      String
  status    ProjectStatus @default(PLANNING)
  startDate DateTime?     @map("start_date")
  endDate   DateTime?     @map("end_date")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  order            Order             @relation(fields: [orderId], references: [id])
  projectEmployees ProjectEmployee[]

  @@map("projects")
}

model ProjectEmployee {
  projectId  String   @map("project_id")
  employeeId String   @map("employee_id")
  role       String?
  assignedAt DateTime @default(now()) @map("assigned_at")

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([projectId, employeeId])
  @@map("project_employees")
}

